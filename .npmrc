# @react-native-community/datetimepicker declares react-native-windows as an
# *optional* peer; npm still checks its latest release (peer react-native
# ^0.85) against our react-native 0.88 and refuses to install (ERESOLVE).
# legacy-peer-deps skips that check. Side effect: required peers are no longer
# auto-installed, so react-dom, @react-native/metro-config and
# @react-native/jest-preset are declared explicitly in package.json.
# Also read by EAS Build's `npm ci`. Remove once the upstream conflict is gone.
legacy-peer-deps=true
