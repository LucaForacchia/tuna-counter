{
  "expo": {
    "name": "Tuna Counter",
    "slug": "tuna-counter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tunacounter",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.ibob_42.tunacounter",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0F8B8D",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4EFE6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 288,
          "dark": {
            "backgroundColor": "#15130E",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-sqlite",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5b1fff23-705d-45f5-9599-d3c969be78e5"
      }
    },
    "owner": "ibob42-snails"
  }
}
